generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // SUPERADMIN | ADMIN
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  auditLogs    AuditLog[]
}

model Voter {
  id           String   @id @default(cuid())
  indexNumber  String   @unique // always starts with FCM
  email        String   @unique
  name         String
  passwordHash String? // null until voter activates their account
  activatedAt  DateTime?
  hasVoted     Boolean  @default(false)
  createdAt    DateTime @default(now())
  candidacy    Candidate?
  otp          OtpCode?
}

model OtpCode {
  id        String   @id @default(cuid())
  voterId   String   @unique
  voter     Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model Election {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("DRAFT") // DRAFT | OPEN | CLOSED
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  positions   Position[]
  votes       Vote[]
  auditLogs   AuditLog[]
}

model Position {
  id         String   @id @default(cuid())
  name       String // e.g. President, Secretary
  order      Int      @default(0)
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates Candidate[]
  votes      Vote[]

  @@unique([electionId, name])
}

model Candidate {
  id         String   @id @default(cuid())
  name       String
  bio        String?
  photoUrl   String?
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  voterId    String?  @unique // optional link to a registered voter
  voter      Voter?   @relation(fields: [voterId], references: [id], onDelete: SetNull)
  votes      Vote[]
  createdAt  DateTime @default(now())
}

// Anonymous: intentionally has NO voterId so ballots cannot be traced back.
model Vote {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate  Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([electionId, positionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. ELECTION_OPENED, VOTER_IMPORTED, RESULTS_VIEWED
  detail    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  electionId String?
  election  Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
