# Database
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST.neon.tech/neondb?sslmode=require"

# Session signing secret - CHANGE THIS IN PRODUCTION (long random string)
AUTH_SECRET="dev-only-secret-change-me-in-production-8f3k2j5h7g9d"

# Comma-separated allowed email domains for voters (empty = allow any)
ALLOWED_EMAIL_DOMAINS="st.umat.edu.gh"

# SMTP for sending voter OTP emails (optional in dev - OTPs are printed to server console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ACSES Elections <no-reply@acses.org>"

# Seed superadmin credentials (used by `npm run db:seed`)
