# Neon pooled URL for the app and Prisma Client
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon direct (non-pooler) URL for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session and anonymous ballot signing secret. Keep stable after ballots are cast.
# Generate a unique, random value of at least 32 bytes.
AUTH_SECRET=""

# Comma-separated allowed email domains for voters (empty = allow any)
ALLOWED_EMAIL_DOMAINS="st.umat.edu.gh"

# Gmail or Google Workspace SMTP. Use a Google App Password when required.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Set these only in the environment used to run `npm run db:seed`.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Public app URL (used in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel creates this token when a Blob store is linked to the project.
BLOB_READ_WRITE_TOKEN=""
